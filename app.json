{
  "expo": {
    "name": "uniezz",
    "slug": "uniezz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uniezz",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0D14",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.uniezz",
      "associatedDomains": ["applinks:uniezz.pl", "applinks:uniezz.pl"],
      "appleTeamId": "ZSVCJ3UTY6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B7CFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uniezz",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uniezz.pl",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0D14",
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 390
        }
      ],
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Geist-VariableFont_wght.ttf"]
        }
      ],
      [
        "react-native-nano-icons",
        {
          "iconSets": [
            {
              "inputDir": "./src/ui/icons",
              "outputDir": "./src/ui/icons"
            }
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c5c9a60-e22e-4c76-b2ed-d214c6b602ad"
      }
    },
    "owner": "madis_mobile_it",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9c5c9a60-e22e-4c76-b2ed-d214c6b602ad"
    }
  }
}
