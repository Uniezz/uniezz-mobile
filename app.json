{
  "expo": {
    "name": "Uniezz",
    "slug": "Uniezz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "uniezz",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.uniezz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#232A5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uniezz"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232A5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Geist-VariableFont_wght.ttf"]
        }
      ],
      [
        "react-native-nano-icons",
        {
          "iconSets": [
            {
              "inputDir": "./src/ui/icons",
              "outputDir": "./src/ui/icons"
            }
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
