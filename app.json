{
  "expo": {
    "name": "uniezz",
    "slug": "uniezz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uniezz",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0D14",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.uniezz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B7CFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uniezz"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0D14",
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 390
        }
      ],
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Geist-VariableFont_wght.ttf"]
        }
      ],
      [
        "react-native-nano-icons",
        {
          "iconSets": [
            {
              "inputDir": "./src/ui/icons",
              "outputDir": "./src/ui/icons"
            }
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
